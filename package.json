{
  "name": "gollabara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "golla": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "bun run build:web && bun build --compile src/cli.ts --outfile dist/golla",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "bun-types": "^1.4.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0"
  }
}
