{
  "name": "gollabara",
  "type": "module",
  "version": "0.3.0",
  "description": "One stream of the screenshots, recaps and questions your coding agent sessions produce",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyna/gollabara.git"
  },
  "bin": {
    "golla": "dist/golla.js",
    "gollabara": "dist/golla.js"
  },
  "files": [
    ".claude-plugin",
    "dist/golla.js",
    "plugin",
    "web/dist"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "bun run build:hook && bun run build:cli && bun run build:web",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build:hook": "bun build src/hook/entry.ts --target=bun --outfile plugin/bin/hook.js",
    "build:cli": "bun build src/cli.ts --target=bun --outfile dist/golla.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "bun-types": "^1.4.3",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "jpeg-js": "^0.4.4",
    "lint-staged": "^17.6.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,mjs,cjs}": ["eslint --fix"],
    "*.{json,md,yaml,yml}": ["eslint --fix"]
  }
}
