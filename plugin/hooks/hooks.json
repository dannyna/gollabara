{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/../src/cli.ts\" hook", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/../src/cli.ts\" hook", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/../src/cli.ts\" hook", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/../src/cli.ts\" hook", "timeout": 5 }] }]
  }
}
