{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/hook.js\"", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/hook.js\"", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/hook.js\"", "timeout": 5 }] }],
    "Stop": [{
      "hooks": [
        { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/hook.js\"", "timeout": 5 },
        { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/hook.js\" wait", "asyncRewake": true, "timeout": 86400 }
      ]
    }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/hook.js\"", "timeout": 5 }] }]
  }
}
